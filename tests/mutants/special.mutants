T=tests/sim-systems.test.mjs; S=elm/Sim
m $S/Systems.elm 's/\| outerHull = M.clamp 0 100 \(start.outerHull - amount \* 0.85\)/| outerHull = (\\v -> if isNaN v then 1 \/ 0 else v) (M.clamp 0 100 (start.outerHull - amount * 0.85))/' nan-becomes-infinity $T
m $S/Systems.elm 's/\| outerHull = M.clamp 0 100 \(start.outerHull - amount \* 0.85\)/| outerHull = (\\v -> if isNaN v then -1 \/ 0 else v) (M.clamp 0 100 (start.outerHull - amount * 0.85))/' nan-becomes-negative-infinity $T
