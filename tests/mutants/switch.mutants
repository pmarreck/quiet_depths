T="tests/sim-patrol.test.mjs tests/elm-simulation.test.mjs tests/elm-simulation-orders.test.mjs"; PT=elm/Sim/Patrol.elm; PC=elm/Sim/PatrolCommand.elm; PO=elm/Sim/PatrolOrders.elm; SW=elm/SimWorker.elm; WM=typescript/world-mirror.ts; ES=typescript/elm-simulation.ts; SM=typescript/simulation.ts
m $PT 's/ \|\| input.paused \|\| / || /' pt-paused "$T"
m $PT 's/ticks input \(M.min dt 60\)/ticks input (M.min dt 30)/' pt-cap "$T"
m $PT 's/M.min 0.25 left/M.min 0.5 left/' pt-tick-size "$T"
m $PT 's/ticks input \(M.min dt 60\) \{ s \| replay = \[\], invalid = \[\] \} \[\]/ticks input (M.min dt 60) s []/' pt-step-drain "$T"
m $PT 's/:: done\)/:: List.drop 1 done)/' pt-tick-lost "$T"
m $PT 's/\{ world = after, replay = replay, invalid = invalid \}/{ world = after, replay = [], invalid = invalid }/' pt-tick-replay "$T"
m $PT 's/PatrolContacts.photograph \(environment s\) look s/PatrolContacts.photograph (environment s) (look + 1) s/' pt-photo-look "$T"
m $PT 's/Combat.launchTorpedo \(environment s\) id s/Combat.launchTorpedo (environment s) "" s/' pt-fire-id "$T"
m $PT 's/\( E.bool ok, after \)\)/( E.bool (not ok), after ))/' pt-drone-result "$T"
m $PT 's/\( E.null, DroneOrders.recallDrone s \)/( E.null, s )/' pt-recall "$T"
m $PT 's/\( E.null, Combat.aimGunAt point s \)/( E.null, s )/' pt-aim "$T"
m $PT 's/Periscope.orderScope raised s/Periscope.orderScope (not raised) s/' pt-scope "$T"
m $PT 's/\{ s \| recon = Maybe.withDefault s.recon after.recon \}/s/' pt-recon-back "$T"
m $PT 's/\{ s \| status = after.status, events = after.events, debrief = after.debrief \}/{ s | status = after.status, events = after.events }/' pt-early-debrief "$T"
m $PT 's/rescued = toFloat o.rescued/rescued = 0/' pt-early-rescued "$T"
m $PT 's/Mechanics.log text kind s/Mechanics.log text Mechanics.Info s/' pt-log-kind "$T"
m $PT 's/\{ result = result, world = world, replay = replay, invalid = invalid \}/{ result = result, world = world, replay = [], invalid = invalid }/' pt-act-replay "$T"
m $PC 's/\|> andMap \(switch "paused"\)/|> andMap (switch "modal")/' pc-paused "$T"
m $PC 's/\( "scribbler", Sonar.Scribbler \), \( "painter", Sonar.Painter \)/( "scribbler", Sonar.Painter ), ( "painter", Sonar.Scribbler )/' pc-imaging "$T"
m $PC 's/\|> andMap \(optional "lampInView" \(D.nullable D.string\) \|> D.map \(Maybe.andThen identity\)\)/|> andMap (D.succeed Nothing)/' pc-lamp "$T"
m $PC 's/\|> andMap \(optional "vx" D.float\)/|> andMap (D.succeed Nothing)/' pc-aim-vx "$T"
m $PC 's/\(D.field "y" D.float\) \(D.field "size" D.float\)/(D.field "y" D.float) (D.succeed 10000)/' pc-recon-size "$T"
m $PC 's/D.map \(Maybe.withDefault Mechanics.Info\)/D.map (Maybe.withDefault Mechanics.Warning)/' pc-log-default "$T"
m $PC 's/key == "replay" \|\| key == "invalid"/key == "replay"/' pc-announce "$T"
m $PO 's/        , engine = o.engine\n/        , engine = s.engine\n/' po-engine "$T"
m $PO 's/        , dieselMode = o.dieselMode\n/        , dieselMode = s.dieselMode\n/' po-diesel "$T"
m $PO 's/        , towerPitch = o.towerPitch\n/        , towerPitch = s.towerPitch\n/' po-tower-pitch "$T"
m $PO 's/        , repair = o.repair\n/        , repair = s.repair\n/' po-repair "$T"
m $PO 's/        , reconArchivedSequence = o.reconArchivedSequence\n/        , reconArchivedSequence = s.reconArchivedSequence\n/' po-recon-archive "$T"
m $PO 's/        , imagers = o.imagers\n/        , imagers = s.imagers\n/' po-imagers "$T"
m $PO 's/elevation = o.gun.elevation/elevation = gun.elevation/' po-gun-elevation "$T"
m $PO 's/nosePitch = o.drone.nosePitch/nosePitch = drone.nosePitch/' po-nose-pitch "$T"
m $PO 's/targetHeading = o.drone.targetHeading/targetHeading = drone.targetHeading/' po-drone-heading "$T"
m $PO 's/\|> andMap \(nullable "route" WorldDecoder.route\)/|> andMap (D.succeed Nothing)/' po-route "$T"
m $SW 's/\( Just \(List.foldl \(\\t _ -> t.world\) s ticks\)/( Just s/' sw-step-model "$T"
m $SW 's/\( Just done.world, PatrolCommand.encodeDone done \)/( Just s, PatrolCommand.encodeDone done )/' sw-act-model "$T"
m $SW 's/\( model, E.object \[ \( "world", E.null \) \] \)/( Nothing, E.object [ ( "world", E.null ) ] )/' sw-refused-model "$T"
m $SW 's/\|> D.map \(\\s -> \( Just s, E.object \[ \( "world", WorldEncoder.encodeWorld s \) \] \)\)/|> D.map (\\s -> ( model, E.object [ ( "world", WorldEncoder.encodeWorld s ) ] ))/' sw-load "$T"
m $WM 's/if \(isRecord\(n\) && n.id !== undefined\) \{/if (false) {/' wm-by-id "$T"
m $WM 's/return same\?.length \? same.shift\(\) : n;/return n;/' wm-reuse "$T"
m $WM 's/if \(!\(k in next\) && !keep.includes\(k\)\) delete old\[k\];/if (false) delete old[k];/' wm-delete "$T"
m $WM 's/Object.is\(x, -0\) \|\| !Number.isFinite\(x\)\) \?/!Number.isFinite(x)) ?/' wm-key-zero "$T"
m $ES 's/    if \(s === held\) \{ checked\(s\); return; \}/    { checked(s); return; }/' es-hold "$T"
m $ES 's/markReplay\(s, m.time, m.event\)/markReplay(s, 0, m.event)/' es-mark-time "$T"
m $ES 's/        afterTick\?.\(s\);\n//' es-after-tick "$T"
m $ES 's/keys.filter\(k => from\[k\] !== undefined\)/keys/' es-defined "$T"
m $ES 's/    if \(stray.length\) onStray\(stray\);/    if (false) onStray(stray);/' es-stray "$T"
m $SM "s/elm.act\(s, \{kind: 'fire', id\}\)/elm.act(s, {kind: 'fire', id: 'nobody'})/" sm-fire "$T"
m $SM "s/elm.act\(s, \{kind: 'requestRecon', area\}\)/elm.act(s, {kind: 'requestRecon', area: null})/" sm-recon "$T"
m $SM "s/elm.act\(s, \{kind: 'aimGunAt', ...point\}\)/elm.act(s, {kind: 'aimGunAt', x: point.x, y: point.y})/" sm-aim "$T"
m $SM "s/elm.act\(s, \{kind: 'log', text, logKind\}\)/elm.act(s, {kind: 'log', text})/" sm-log "$T"
m $SM "s/elm.act\(s, \{kind: 'fireDeckGun', bearing: aim.bearing, elevation: aim.elevation\}\)/elm.act(s, {kind: 'fireDeckGun', bearing: aim.bearing, elevation: 0})/" sm-gun "$T"
