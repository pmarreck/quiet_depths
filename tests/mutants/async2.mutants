T="tests/elm-simulation.test.mjs tests/elm-simulation-orders.test.mjs tests/persistence.test.mjs"; WM=typescript/world-mirror.ts; ES=typescript/elm-simulation.ts; SM=typescript/simulation.ts; PT=typescript/patrol-transfer.ts; WS=scripts/sim-worker-script.mjs
m $ES 's/    const run = tail.then\(\(\) => job\(exchange\)\);/    const run = Promise.resolve().then(() => job(exchange));/' es-queue-wait "$T"
m $ES 's/waiting = reply => \{ if \(reply.error\) reject/waiting = reply => { if (false) reject/' es-refusal "$T"
m $ES 's/    if \(!deliver\) throw new Error\(.The Elm simulation replied to no command.\);\n//' es-unasked "$T"
m $ES 's/    const own = changed\(s, t\);\n/    const own = new Map();\n/' es-call-changes "$T"
m $ES 's/    for \(const i of own.keys\(\)\) t.logged\[i\] = key\(at\(s, places\[i\]\)\);\n//' es-call-logged "$T"
m $ES 's/    t.unreplied.push\(own\);\n//' es-call-pending "$T"
m $ES 's/        if \(t.unreplied\[0\] === own\) t.unreplied.shift\(\);\n        t.logged/        t.logged/' es-refused-shift "$T"
m $ES 's/        t.logged = merged\(t.base, t.unreplied\).map\(key\);\n        throw e;/        throw e;/' es-refused-logged "$T"
m $ES 's/    const over = new Map\(\[...t.unreplied.flatMap\(c => \[...c\]\), ...since\]\);/    const over = new Map([...since]);/' es-over-later "$T"
m $ES 's/    const over = new Map\(\[...t.unreplied.flatMap\(c => \[...c\]\), ...since\]\);/    const over = new Map([...t.unreplied.flatMap(c => [...c])]);/' es-over-since "$T"
m $ES 's/    if \(s === held\) return;\n    const world/    const world/' es-held "$T"
m $ES 's/      if \(t.base\[i\] === undefined\) delete into\[f\]; else into\[f\] = t.base\[i\];/      if (t.base[i] === undefined) delete into[f];/' es-load-base "$T"
m $ES 's/    if \(!t\) throw new Error\(.The Elm simulation was handed a patrol it did not create or restore.\);\n    return t;/    return t ?? {base: [], logged: [], unreplied: [], replied: new Map()};/' es-untracked "$T"
m $ES 's/\(\) => beforeTicks\?.\(s\), i => \{ announce\(s, ticks\[i\]\); afterTick\?.\(s\); \}/() => beforeTicks?.(s), i => { afterTick?.(s); }/' es-tick-announce "$T"
m $ES 's/i => \{ announce\(s, ticks\[i\]\); afterTick\?.\(s\); \}/i => { announce(s, ticks[i]); }/' es-tick-hook "$T"
m $ES 's/\(\) => beforeTicks\?.\(s\), i =>/() => {}, i =>/' es-before-hook "$T"
m $ES 's/  const orders = \(t: Track, own: Map<number, unknown>\) => shaped\(merged\(t.base, \[own\]\)\);/  const orders = (t: Track, own: Map<number, unknown>) => shaped(t.base);/' es-orders-own "$T"
m $ES 's/places.forEach\(\(\[part, f\], i\) => \{ if \(values\[i\] !== undefined\) \(part/places.forEach(([part, f], i) => { if (true) (part/' es-shaped-undefined "$T"
m $ES 's/for \(const c of changes\) if \(c.has\(i\)\) value = c.get\(i\);/for (const c of changes.slice(0, 1)) if (c.has(i)) value = c.get(i);/' es-merged-all "$T"
m $ES 's/\[...fields.boat.map\(f => \[null, f\] as const\), ...fields.gun.map\(f => \[.gun., f\] as const\), /[...fields.boat.map(f => [null, f] as const), /' es-places-gun "$T"
m $ES 's/if \(fields.boat.includes\(k\) \|\| \(PAGE_FIELDS as readonly string\[\]\).includes\(k\)\) continue;/if (fields.boat.includes(k)) continue;/' es-simulated-page "$T"
m $ES 's/    if \(stray.length\) onStray\(stray\);/    if (stray.length > 1) onStray(stray);/' es-stray-one "$T"
m $ES 's/    held = s;\n    return world;/    return world;/' es-adopt-held "$T"
m $ES 's/      if \(!isRecord\(saved\) \|\| !restorePageFields\(saved\)\) return null;/      if (!isRecord(saved)) return null;/' es-restore-page "$T"
m $SM 's/  try \{ return Promise.resolve\(job\(\)\); \} catch \(e\) \{ return Promise.reject\(e\); \}/  return Promise.resolve(job());/' sm-reject "$T"
m $SM 's/  try \{ return Promise.resolve\(job\(\)\); \}/  try { return job() as Promise<T>; }/' sm-promise "$T"
m $SM 's/  const \{beforeTicks, ...frame\} = input;\n  beforeTicks\?.\(s\);/  const {beforeTicks, ...frame} = input;/' sm-before "$T"
m $SM "s/elm.act\(s, \{kind: 'log', text, logKind\}\)/elm.act(s, {kind: 'log', text})/" sm-log-kind "$T"
m $PT 's/  const patrol=await restore\(JSON.stringify\(value.patrol\)\);/  const patrol=restore(JSON.stringify(value.patrol)) as never as Patrol|null;/' pt-read-await "$T"
m $PT "s/if\(k==='quiet-depths-v1'&&\(await restore\(JSON.stringify\(v\)\)\)\?.status!=='patrol'\)bad\('autosave'\);/if(k==='quiet-depths-v1'\&\&false)bad('autosave');/" pt-autosave "$T"
m $PT 's/  await checkStorage\(v.localStorage,restore,photo\);/  checkStorage(v.localStorage,restore,photo).catch(()=>{});/' pt-storage-await "$T"
m $PT 's/ids.add\(row.id\);slots.push\(\{...await readPatrol\(row,restore,checkStation,true\),id:row.id\}\);/slots.push({...await readPatrol(row,restore,checkStation,true),id:row.id});/' pt-slot-ids "$T"
m $ES 's/    t.logged = merged\(t.base, t.unreplied\).map\(key\);\n    const over/    t.logged = t.base.map(key);\n    const over/' es-landed-logged "$T"
m $ES 's/    if \(t.unreplied\[0\] === own\) t.unreplied.shift\(\);\n    const since/    const since/' es-landed-shift "$T"
m $ES 's/    if \(!over.size \|\| !worlds.length\) return;\n    checked\(s, t\);/    if (!over.size || !worlds.length) return;/' es-over-checked "$T"
m $ES 's/      t.base = reported\(t.base, world\);\n      t.replied = simulated\(s\);/      t.base = reported(t.base, world);/' es-tick-settled "$T"
m $ES 's/    if \(top in set\) return structuredClone/    if (false) return structuredClone/' es-reported-set "$T"
m $ES 's/    return whole \|\| unset.includes\(top\) \? undefined : base\[i\];/    return base[i];/' es-reported-unset "$T"
m $ES 's/      if \(world.whole\) refreshMirror\(s, world.set, PAGE_FIELDS\); else refreshChanged/      if (false) refreshMirror(s, world.set, PAGE_FIELDS); else refreshChanged/' es-whole-refresh "$T"
m $ES 's/      t.base = reported\(t.base, world\);/      t.base = places.map(p => structuredClone(at(s, p)));/' es-base-mirror "$T"
m $ES 's/x !== undefined && typeof x !== .function.\)/x !== undefined)/' es-plain-function "$T"
m $ES 's/: isRecord\(v\) \? Object.fromEntries/: false ? Object.fromEntries/' es-plain-record "$T"
m $ES 's/const worldOf = \(r: Sent\): Fields \| null => r.world \?\? r.changes\?.set \?\? null;/const worldOf = (r: Sent): Fields | null => r.world ?? null;/' es-world-of "$T"
m $WM 's/  for \(const k of unset\) delete m\[k\];\n//' wm-unset "$T"
m $WS 's/if \(whole \|\| sent\[k\] !== fields\[k\]\) set\[k\] = v;/if (whole) set[k] = v;/' ws-changed "$T"
m $WS 's/if \(whole \|\| sent\[k\] !== fields\[k\]\) set\[k\] = v;/set[k] = v;/' ws-all "$T"
m $WS 's/    const unset = whole \? \[\] : Object.keys\(sent\).filter\(k => !\(k in fields\)\);/    const unset = [];/' ws-unset "$T"
m $WS "s/    if \(\['create', 'restore', 'load'\].includes\(event.data && event.data.kind\)\) sent = null;\n//" ws-fresh "$T"
m $WS 's/typeof x === .number. && \(Object.is\(x, -0\) \|\| !Number.isFinite\(x\)\)/false/' ws-key-exact "$T"
m $ES 's/      landed\(s, t, \[changesOf\(done\)!\], own\);\n      announce\(s, done\);/      landed(s, t, [changesOf(done)!], own);/' es-act-announce "$T"
m $WS 's/    if \(reply.ticks\) out.ticks = reply.ticks.map\(\(\{world, ...tick\}\) => \(\{...tick, changes: changes\(world\)\}\)\);/    if (reply.ticks) out.ticks = reply.ticks.slice(-1).map(({world, ...tick}) => ({...tick, changes: changes(world)}));/' ws-relay-ticks "$T"
