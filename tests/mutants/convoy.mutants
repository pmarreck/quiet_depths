T=tests/sim-convoy-watch.test.mjs; CW=elm/Sim/ConvoyWatch.elm; AW=elm/Sim/AlliedWatch.elm; CS=elm/Sim/ConvoySaves.elm
m $CW 's/45 \+ h 4 \* 30/45 + h 4 * 20/' setup-wolf-depth $T
m $CW 's/if h 5 < 0.5 then/if h 5 < 0.6 then/' setup-side $T
m $CW 's/\.height - 8\)\)/.height - 7))/' setup-wreck-clearance $T
m $CW 's/Mechanics.bearing s wren \+ 356/Mechanics.bearing s wren + 355/' setup-heading $T
m $CW 's/\(1100 \+ h 6 \* 500\)/(1100 + h 6 * 400)/' setup-wolf-range $T
m $CW 's/next = 80 \+ h 8 \* 30/next = 80 + h 8 * 20/' setup-first-raid $T
m $CW 's/toFloat \(floor \(range \/ 100\)\) \* 0.1/toFloat (round (range \/ 100)) * 0.1/' hail-range-floor $T
m $CW 's/s.scope && 0 < Equipment.operatingFraction/s.scope \&\& 0 <= Equipment.operatingFraction/' scope-damaged $T
m $CW 's/                                if s0.depth <= 1 then/                                if s0.depth <= 2 then/' hail-depth $T
m $CW 's/M.max 3400 \(range \* 1.35\)/M.max 3000 (range * 1.35)/' hail-reach-floor $T
m $CW 's/M.max 3400 \(range \* 1.35\)/M.max 3400 (range * 1.25)/' hail-reach-range $T
m $CW 's/M.notLess m0.elapsed 90/M.notLess m0.elapsed 80/' repeat-age $T
m $CW 's/completedAt\) 60 then/completedAt) 50 then/' repeat-after-copy $T
m $CW 's/                                        s2.depth <= 15 && scopeClear s2 env/                                        s2.depth <= 16 \&\& scopeClear s2 env/' lamp-scope-depth $T
m $CW 's/                                        s2.depth <= 1\n/                                        s2.depth <= 2\n/' lamp-tower-depth $T
m $CW 's/optical && input.lampInView == Just sender.id && Mechanics.distance s2 sender <= range/optical \&\& input.lampInView == Just sender.id/' lamp-range $T
m $CW 's/SignalLamp.copyLamp \(dt \/ M.max 1 rate\) seen m1/SignalLamp.copyLamp dt seen m1/' lamp-time-rate $T
m $CW 's/next = c0.next \+ dt \}/next = c0.next }/' raid-waits $T
m $CW 's/if M.truthy shot0.damage && 0 < target.hull then/if 0 < target.hull then/' torpedo-follows-hit $T
m $CW 's/                        0 < shot.damage && 0 < target.hull\n/                        0 < shot.damage\n/' hit-afloat $T
m $CW 's/if M.notLess s.time shot.arrives then/if s.time > shot.arrives then/' arrival-edge $T
m $CW 's/depth = Just 2, altitude = Nothing, power = 0.85/depth = Just 2, altitude = Nothing, power = 0.8/' detonation-power $T
m $CW 's/next = s.time \+ 42 \+ roll 0 \* 28/next = s.time + 40 + roll 0 * 28/' raid-interval $T
m $CW 's/roll 2 < 0.76/roll 2 < 0.7/' raid-hit-odds $T
m $CW 's/45 \+ toFloat \(floor \(roll 3 \* 21\)\)/45 + toFloat (floor (roll 3 * 20))/' raid-damage $T
m $CW 's/                                    120\n/                                    100\n/' raid-miss-offset $T
m $CW 's/arrives = s.time \+ 12 \+ roll 4 \* 14/arrives = s.time + 12 + roll 4 * 12/' raid-run-time $T
m $CW 's/depth = Just wolfDepth, altitude = Nothing, power = 0.45/depth = Just wolfDepth, altitude = Nothing, power = 0.4/' seeker-power $T
m $CW 's/v.kind == Surface Escort && v.disabled \/= Just True/v.kind == Surface Escort/' escort-disabled $T
m $CW 's/sin a \* -30/sin a * -20/' charge-astern $T
m $CW 's/depth = 40 \+ roll 5 \* 30/depth = 40 + roll 5 * 20/' charge-depth $T
m $CW 's/, delay = 6, kind = Charge/, delay = 5, kind = Charge/' charge-delay $T
m $CW 's/\{ b \| convoyCharge = Just True \}/b/' charge-marked $T
m $CW 's/Mechanics.distance wolf charge < 650/Mechanics.distance wolf charge < 600/' charge-reach $T
m $CW 's/14600\) < 0.32 then/14600) < 0.3 then/' charge-odds $T
m $CW 's/v.hull - 14 - 12 \*/v.hull - 12 - 12 */' charge-damage $T
m $AW 's/7 \+ toFloat index \* 6/7 + toFloat index * 5/' watch-beat-offset $T
m $AW 's/\(s.time - offset\) \/ 36\) \/= floor \(\(s.time - dt - offset\) \/ 36\)/(s.time - offset) \/ 30) \/= floor ((s.time - dt - offset) \/ 30)/' watch-beat-period $T
m $AW 's/Mechanics.distance s ship0 < 4200/Mechanics.distance s ship0 < 4000/' sweep-range $T
m $AW 's/floor s.time \* 17 \+ index/floor s.time * 13 + index/' sweep-roll $T
m $AW 's/Mechanics.distance ship0 v < 1800/Mechanics.distance ship0 v < 1600/' fix-range $T
m $AW 's/s.time - fix.time < 45/s.time - fix.time < 40/' fix-freshness $T
m $AW 's/completedAt\) 6\)/completedAt) 5)/' delivered-stands $T
m $AW 's/180 < s2.time - current.estimate.time/170 < s2.time - current.estimate.time/' uncopied-stands $T
m $AW 's/initial.elapsed < 20/initial.elapsed < 15/' convoy-first $T
m $AW 's/if s2.depth <= 1 && not copyingInitial then/if s2.depth <= 1 then/' wait-for-convoy $T
m $AW 's/lastIssue = -1 \}/lastIssue = 0 }/' watch-fresh-issue $T
m $AW 's/\(Maybe.map \(\\c -> c.time < fix.time\) candidate \|> Maybe.withDefault True\)/True/' freshest-fix $T
m $CS 's/0 <= c.round && //' save-round $T
m $CS 's/safeCount c.number && //' save-number $T
m $CS 's/ && 0 <= c.next && / \&\& /' save-next $T
m $CS 's/ && m.estimate.number == c.number//' save-message-number $T
m $CS 's/ && pin.number <= c.number//' save-pin-number $T
m $CS 's/M.isZero wreck.hull && //' save-wreck-hull $T
m $CS 's/                                < s.weaponSequence\n/                                <= s.weaponSequence\n/' save-shot-id $T
m $CS 's/ && f.number <= w.sequence//' save-fix-sequence $T
m $CS 's/valid f && f.sender == v.id/valid f/' save-fix-sender $T
m $CS 's/List.length \(List.filter \(\\v -> v.incidental \/= Just True\) s.ships\)/List.length s.ships/' save-incidental $T
