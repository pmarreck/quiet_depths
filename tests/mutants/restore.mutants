T="--test-name-pattern=current|any.field|older tests/sim-patrol-restore.test.mjs"; SF=elm/Sim/SaveFields.elm; RF=elm/Sim/RestoreFields.elm; RS=elm/Sim/RestoreStores.elm; RC=elm/Sim/RestoreChecks.elm; PR=elm/Sim/PatrolRestore.elm
m $SF 's/integer v && M.abs v <= 9007199254740991/integer v/' sf-safe-range "$T"
m $SF 's/D.string \|> D.map \(\\s -> s \/= ""\)/D.string |> D.map (\\_ -> True)/' sf-truthy-empty "$T"
m $SF 's/\[ D.null False\n/[ D.null True\n/' sf-truthy-null "$T"
m $SF 's/D.float \|> D.map M.truthy/D.float |> D.map (\\_ -> True)/' sf-truthy-zero "$T"
m $SF 's/if D.decodeValue \(D.null \(\)\) v == Ok \(\) then\n(\s+)Dict.insert key value fields/if False then\n${1}Dict.insert key value fields/' sf-fill-nullish "$T"
m $SF 's/        Ok _ ->\n            Nothing\n/        Ok _ ->\n            Just Dict.empty\n/' sf-object-array "$T"
m $RF 's/\(number "version" f\n(\s+)== Just 1/(number "version" f\n${1}\/= Nothing/' rf-version "$T"
m $RF 's/absentOr "scopeTravel" \(\\v -> 0 <= v && v <= 1\)/absentOr "scopeTravel" (\\v -> 0 <= v \&\& v <= 2)/' rf-scope-travel "$T"
m $RF 's/\(m == Just Henhouse \|\| not \(Dict.member "convoy" f\) && status \/= Just "convoy-lost"\)/(m == Just Henhouse || status \/= Just "convoy-lost")/' rf-convoy-mission "$T"
m $RF 's/text "phase" f == Just "objective" && //' rf-partial-phase "$T"
m $RF 's/M.notLess \(t \+ 0.001\) v/M.notLess (t + 1) v/' rf-imaging-time "$T"
m $RF 's/absentOr "newYearWatch" \(\\v -> safeInteger v && 0 <= v\)/absentOr "newYearWatch" (\\v -> 0 <= v)/' rf-new-year "$T"
m $RF 's/absentOr "unpoweredSince" \(\\v -> 0 <= v && M.notLess t v\)/absentOr "unpoweredSince" (\\v -> 0 <= v)/' rf-unpowered "$T"
m $RF 's/\( "orbitCamera", E.bool False \)/( "orbitCamera", E.bool True )/' rf-orbit-default "$T"
m $RF 's/fillNullish "wake"/fill "wake"/' rf-wake-null "$T"
m $RF 's/entries "wake" 28/entries "wake" 29/' rf-wake-limit "$T"
m $RF 's/0 <= b && b < 360/0 <= b \&\& b <= 360/' rf-bearing-360 "$T"
m $RF 's/String.length words <= 220/String.length words <= 2200/' rf-debrief-length "$T"
m $RF 's/String.length s == 32/String.length s == 31/' rf-patrol-id "$T"
m $RF 's/M.notLess \(t \+ MessWatch.launchWatchSeconds\) v/M.notLess t v/' rf-crew-quiet "$T"
m $RF 's/\(time f2 \+ 8\)/(time f2 + 9)/' rf-next-lightning "$T"
m $RF 's/fill "soundSequence" \(E.float 1\)/fill "soundSequence" (E.float 2)/' rf-sound-sequence "$T"
m $RF 's/Just \( "photoGoal", E.float 2 \)/Just ( "photoGoal", E.float 3 )/' rf-photo-goal "$T"
m $RF 's/number "rng" f \|> Maybe.withDefault 0/number "time" f |> Maybe.withDefault 0/' rf-env-seed "$T"
m $RS 's/\(\\v -> 0 <= v && v <= 24\)/(\\v -> 0 <= v \&\& v <= 25)/' rs-fuel-fire "$T"
m $RS 's/\|> Dict.insert "fuelTank" \(E.float 100\)/|> Dict.insert "fuelTank" (E.float 90)/' rs-fuel-tank "$T"
m $RS 's/if Dict.get "systems" f \|> Maybe.map truthy \|> Maybe.withDefault False then/if True then/' rs-plant-truthy "$T"
m $RS 's/\( "runSetting", E.float 4320 \)/( "runSetting", E.float 4321 )/' rs-run-setting "$T"
m $RS 's/Dict.insert "outerHull" hull f1/Dict.insert "outerHull" (E.float 100) f1/' rs-outer-hull "$T"
m $RS 's/\( "towerAngle", E.float 0 \)/( "towerAngle", E.float 1 )/' rs-tower-angle "$T"
m $RS 's/M.notLess \(t \+ 100\) v/M.notLess (t + 10) v/' rs-tube-time "$T"
m $RS 's/\(\\n -> integer n && 0 <= n\)/(\\n -> 0 <= n)/' rs-torps-integer "$T"
m $RS 's/fill "deckgun" \(E.float 100\)/fill "deckgun" (E.float 50)/' rs-deckgun "$T"
m $RC 's/Just Number ->\n(\s+)number key f \/= Nothing/Just Number ->\n${1}True/' rc-template-number "$T"
m $RC 's/0 <= v && v <= t\) >> Result.withDefault False/0 <= v) >> Result.withDefault False/' rc-collision-hits "$T"
m $RC 's/&& \(Dict.get "drone" f \|> Maybe.map truthy \|> Maybe.withDefault False\)/\&\& True/' rc-drone-truthy "$T"
m $RC 's/PatrolCalendar.sailingDay >> toFloat >> E.float/(\\_ -> 0) >> toFloat >> E.float/' rc-sailing-day "$T"
m $RC 's/integerIn 0 365/integerIn 0 366/' rc-start-day "$T"
m $RC 's/if 0 <= n && n <= 100 then/if 0 <= n then/' rc-limit-range "$T"
m $RC 's/m == Tiebreaker && torps <= 3/m == Tiebreaker \&\& torps <= 2/' rc-fleet-load "$T"
m $RC 's/\(E.float \(torps \+ load - 3\)\)/(E.float (torps + load - 2))/' rc-fleet-torps "$T"
m $RC 's/\[ "idle", "arming", "airborne", "spent" \]/[ "idle", "arming", "airborne" ]/' rc-air-status "$T"
m $RC 's/kind \/= "sub" \|\| depth/True/' rc-sub-depth "$T"
m $RC 's/\(E.float \(M.max 1 \(number "delay" b1/(E.float (M.max 0 (number "delay" b1/' rc-blast-fuse "$T"
m $RC 's/SaveFields.fill "exploded" \(E.bool \(0 < age\)\)/SaveFields.fill "exploded" (E.bool (0 <= age))/' rc-blast-exploded "$T"
m $RC 's/SaveFields.fill "explodedAt" \(E.float \(t - age\)\)/SaveFields.fill "explodedAt" (E.float t)/' rc-blast-exploded-at "$T"
m $PR 's/SaveFields.integer fighters && SaveFields.integer hits && /SaveFields.integer hits \&\& /' pr-carrier-fighters "$T"
m $PR 's/\n(\s+)&& \(s.phase == Objective \|\| MissionObjective.allSunk s.ships MissionObjective.convoyTransportIds\)//' pr-convoy-phase "$T"
m $PR 's/s.departure \/= Nothing && //' pr-transit-departure "$T"
m $PR 's/v.id == "echo" && v.kind == Submarine && v.military == Just True/v.id == "echo"/' pr-subhunt "$T"
m $PR 's/    else\n        s.search == Nothing/    else\n        True/' pr-search-none "$T"
m $PR 's/0 <= p.age && p.age <= s.time/0 <= p.age \&\& p.age < s.time/' pr-crew-age "$T"
m $PR 's/M.max quiet \(s.time - p.age \+ MessWatch.launchWatchSeconds\)/M.max quiet (s.time - p.age)/' pr-crew-watch "$T"
m $PR 's/\(not \(Dict.member "crewQuietUntil" fields\)\)/False/' pr-legacy-crew "$T"
m $PR 's/D.map SaveFields.truthy/D.map (\\_ -> False)/' pr-weapon-exploded "$T"
m $PR 's/\.belowKeel s.battery Nothing/.belowKeel 100 Nothing/' pr-warnings-battery "$T"
