T=tests/sim-cold-watch.test.mjs; D=elm/Sim/StandDecisions.elm; S=elm/Sim/Stands.elm; W=elm/Sim/ColdWatch.elm; E=elm/Sim/TrafficEncounters.elm; V=elm/Sim/TrafficSaves.elm
m $D 's/negate \(Maybe.withDefault 20 v.depth\)/negate (Maybe.withDefault 0 v.depth)/' sub-default-depth $T
m $D 's/roll < 0.34 then/roll < 0.3 then/' miss-chance $T
m $D 's/                            0.45\n/                            0.5\n/' assist-weight $T
m $D 's/strength c \* 1.5 < strength v/strength c * 1.4 < strength v/' strength-ratio $T
m $D 's/s.time - o.time < 75\)/s.time - o.time < 70)/' deliberate-age $T
m $D 's/0 < p.level && s.time - o.time/0 <= p.level \&\& s.time - o.time/' deliberate-level $T
m $D 's/\* 0.035/* 0.03/' flood-damage $T
m $D 's/                        0.48\n/                        0.4\n/' disabled-damage $T
m $D 's/p0.range \+ 75 < d/p0.range + 70 < d/' leaving-margin $T
m $D 's/damage \* \(1.25 - 0.75 \* aggression\)/damage * (1.25 - 0.7 * aggression)/' hurt-retreat-odds $T
m $D 's/0.3 \+ 0.65 \* aggression/0.3 + 0.6 * aggression/' help-odds $T
m $D 's/0.91 < aggression/0.9 < aggression/' spoiling-threshold $T
m $D 's/roll 4 < initiative \* 0.65\)/roll 4 < initiative * 0.6)/' spoiling-odds $T
m $D 's/if target.id \/= "player" && not \(disabled v\) && v.kind \/= Surface Merchant then/if target.id \/= "player" \&\& v.kind \/= Surface Merchant then/' disabled-holds-fire $T
m $S 's/Surface Carrier ->\n            4\n/Surface Carrier ->\n            3\n/' carrier-strength $T
m $S 's/            0.5\n/            0.6\n/' disabled-strength $T
m $S 's/time - t < 45/time - t < 40/' recent-attack $T
m $W 's/hull = Carrier.incidentalHull \{ kind = target.kind, hull = target.hull, directHits = floor \(Maybe.withDefault 0 target.directHits\) \} shot.damage/hull = M.max 0 (target.hull - shot.damage)/' carrier-floor $T
m $E 's/roll 2 < 0.52 then/roll 2 < 0.5 then/' convoy-odds $T
m $E 's/List.range 0 15\n/List.range 0 7\n/' bearing-trials $T
m $E 's/toFloat trial \* pi \/ 8/toFloat trial * pi \/ 4/' bearing-step $T
m $E 's/                30\n\n             else\n                10\n/                25\n\n             else\n                10\n/' sub-water-depth $T
m $E 's/                30\n\n             else\n                10\n/                30\n\n             else\n                15\n/' surface-water-depth $T
m $E 's/\(count > 1 \|\| roll 4 < 0.65\)/(count > 1 || roll 4 < 0.6)/' escort-odds $T
m $E 's/position.y - 8\)/position.y - 10)/' sub-keel-margin $T
m $V 's/toFloat \(floor \(s.time \/ Encounters.halfDay\)\)\n/toFloat (floor (s.time \/ Encounters.halfDay)) + 1\n/' save-window-max $T
m $V 's/slot group && slot index/slot group/' save-passage-index $T
m $V 's/String.all digit window/True/' save-passage-digits $T
