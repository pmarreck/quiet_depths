T=tests/sim-weather.test.mjs; E=elm/Sim/Environment.elm; B=elm/Sim/BoatSensors.elm
m $E 's/    19830604/    19830605/' default-seed "$T"
m $E 's/toFloat \(Bitwise.shiftRightZfBy 0 \(M.toInt32 seed\)\)/toFloat (M.toInt32 seed)/' unsigned "$T"
m $E 's/hash01 seed 750 \* 4/hash01 seed 751 * 4/' random-hour "$T"
m $E 's/Maybe.withDefault 18/Maybe.withDefault 12/' default-hour "$T"
m $E 's/hash01 seed 751 \* 4/hash01 seed 750 * 4/' random-weather "$T"
m $E 's/                        Cloudy ->\n                            from Rain\n\n                        Rain ->\n                            from Storm/                        Cloudy ->\n                            from Storm\n\n                        Rain ->\n                            []/; s/                        Storm ->\n                            \[\]/                        Storm ->\n                            from Rain/' weather-order "$T"
m $E 's/            if M.truthy s.time then/            if True then/' falsy-time "$T"
m $E 's/floor \(time \/ 300\)/floor (time \/ 360)/' front-length "$T"
m $E 's/            if n <= 0 then/            if n < 0 then/' first-front "$T"
m $E 's/smooth 0 75 \(M.remainder time 300\)/smooth 0 60 (M.remainder time 300)/' blend-time "$T"
m $E 's/\( idAt \(slot - 1\), idAt slot \)/( idAt slot, idAt slot )/' earlier-front "$T"
m $E 's/ 24 \+ 24\) 24/ 24) 24/' hour-wrap "$T"
m $E 's/\(hour - 6\) \* pi \/ 12/(hour - 5) * pi \/ 12/' sun-angle "$T"
m $E 's/smooth -0.14 0.18 sunAltitude/smooth -0.15 0.18 sunAltitude/' daylight "$T"
m $E 's/1 - M.abs \(daylight \* 2 - 1\)/1 - M.abs (daylight * 2 - 0.9)/' twilight "$T"
m $E 's/        if daylight < 0.12 then\n            Night/        if daylight < 0.1 then\n            Night/' night "$T"
m $E 's/        else if daylight > 0.9 then\n            Daytime/        else if daylight > 0.92 then\n            Daytime/' daytime "$T"
m $E 's/        else if hour < 12 then\n            Dawn/        else if hour < 11 then\n            Dawn/' dawn-dusk "$T"
m $E 's/\(8150 \+ toFloat/(8151 + toFloat/' mist-key "$T"
m $E 's/            if mist < 0.46 then/            if mist < 0.5 then/' mist-chance "$T"
m $E 's/\(1 - smooth 0.05 0.55 rain\)/(1 - smooth 0.05 0.6 rain)/' rain-clears-fog "$T"
m $E 's/smooth 4.5 5.75 hour/smooth 4.5 6 hour/' fog-forms "$T"
m $E 's/\(1 - smooth 7 9 hour\)/(1 - smooth 7 9.5 hour)/' fog-lifts "$T"
m $E 's/\(0.64 \+ 0.3 \* mist \/ 0.46\)/(0.64 + 0.32 * mist \/ 0.46)/' fog-density "$T"
m $E 's/        if fog > 0.16 then\n            "Morning fog"/        if fog > 0.2 then\n            "Morning fog"/' fog-name "$T"
m $E 's/mixed .visibility \* \(1 - 0.79 \* fog\)/mixed .visibility * (1 - 0.8 * fog)/' fog-visibility "$T"
m $E 's/Maybe.withDefault \(toFloat \(Calendar.sailingDay cfg.seed\)\) cfg.startDay/Maybe.withDefault 0 cfg.startDay/' old-save-day "$T"
m $E 's/angle - 2 \* pi \* calendar.cycle/angle + 2 * pi * calendar.cycle/' lunar-angle "$T"
m $E 's/z = -0.32 \* cos/z = -0.3 * cos/' moon-z "$T"
m $E 's/\(1 - cloud\) \^ 2 \* \(1 - fog\)/(1 - cloud) ^ 3 * (1 - fog)/' clear-light "$T"
m $E 's/smooth -0.01 0.12 moonDirection.y/smooth -0.02 0.12 moonDirection.y/' moonrise "$T"
m $E 's/z = -0.32 \}/z = -0.3 }/' sun-z "$T"
m $E 's/\(3900 \+ 2600 \* daylight\)/(3900 + 2700 * daylight)/' optical "$T"
m $E 's/\(1800 \+ 3700 \* daylight\)/(1800 + 3600 * daylight)/' sub-visual "$T"
m $E 's/\(1 - 0.55 \* fog\)/(1 - 0.5 * fog)/' fog-lights "$T"
m $E 's/daylight < 0.85 \|\| fog > 0.16/daylight < 0.8 || fog > 0.16/' nav-daylight "$T"
m $E 's/daylight < 0.85 \|\| fog > 0.16/daylight < 0.85/' nav-fog "$T"
m $E 's/        else if waveScale < 1.2 then/        else if waveScale < 1.3 then/' sea-state "$T"
m $E 's/if age >= 0 && age < 0.75 then/if age > 0 \&\& age < 0.75 then/' strike-start "$T"
m $E 's/if age >= 0 && age < 0.75 then/if age >= 0 \&\& age <= 0.75 then/' strike-end "$T"
m $E 's/M.exp \(negate age \* 13\)/M.exp (negate age * 12)/' flash-decay "$T"
m $E 's/\(\(age - 0.22\) \/ 0.05\)/((age - 0.2) \/ 0.05)/' second-pulse "$T"
m $E 's/\/ 14000\)\)/\/ 15000))/' flash-distance "$T"
m $E 's/M.max brightest \(pulse/(\\_ -> identity) brightest (pulse/' brightest "$T"
m $E 's/Maybe.map \(\\_ -> time\) s.wavePhase/Maybe.map (\\_ -> s.time) s.wavePhase/' sampled-at "$T"
m $B 's/forward = negate design.scopeZ/forward = design.scopeZ/' scope-forward "$T"
m $B 's/down = negate \(scopeEyeHeight s\)/down = scopeEyeHeight s/' scope-down "$T"
m $B 's/surfaceHeight eye.x eye.y s.time e \+ 0.15/surfaceHeight eye.x eye.y s.time e + 0.1/' spray "$T"
m $B 's/belowKeel = waterDepth - referenceDepth - keelOffset/belowKeel = waterDepth - referenceDepth/' keel "$T"
